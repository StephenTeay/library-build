# ==============================================================================
# FSS-IB E-Learning & Digital Library Portal Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_ORIGIN=http://localhost:5173

# Database (Neon Serverless Postgres / Local Postgres)
# Local Docker development uses port 5433 to avoid host port 5432 conflicts
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/fss_elibrary?sslmode=disable
# In production, use Neon pooled connection string:
# DATABASE_URL=postgresql://fss_user:secret@ep-cool-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Authentication & Session Security
JWT_SECRET=super-secret-jwt-key-replace-in-production-with-min-64-random-chars
COOKIE_SECRET=super-secret-cookie-key-replace-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Bootstrap Super Admin (One-time Initial Registrar Account)
BOOTSTRAP_REGISTRAR_EMAIL=registrar@fss-ibadan.edu.ng
BOOTSTRAP_REGISTRAR_PASSWORD=ChangeMeRegistrar2026!
BOOTSTRAP_REGISTRAR_NAME=Registrar FSS-IB

# Object Storage (Cloudflare R2 / Local LocalStack S3 Stand-in)
# Local LocalStack default credentials:
R2_ACCOUNT_ID=localstack
R2_ACCESS_KEY_ID=test
R2_SECRET_ACCESS_KEY=test
R2_BUCKET_NAME=fss-elibrary-storage
R2_ENDPOINT=http://localhost:4566
R2_S3_FORCE_PATH_STYLE=true
# In production (Cloudflare R2):
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key
# R2_SECRET_ACCESS_KEY=your_r2_secret_key
# R2_BUCKET_NAME=fss-elibrary-storage
# R2_ENDPOINT=https://<your_account_id>.r2.cloudflarestorage.com
# R2_S3_FORCE_PATH_STYLE=false

# Email Delivery (Brevo Transactional API / Dev Local File Logger)
# For development, EMAIL_PROVIDER=console logs to stdout & dev-emails.log
EMAIL_PROVIDER=console
BREVO_API_KEY=xkeysib-mock-or-real-api-key
EMAIL_FROM=portal@fss-ibadan.edu.ng
EMAIL_FROM_NAME="FSS-IB E-Library"

# Cloudflare Pages Functions Proxy Target
BACKEND_ORIGIN=http://localhost:4000
